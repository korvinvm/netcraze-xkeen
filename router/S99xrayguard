#!/bin/sh
# Сторож Xray: запускает keeper.sh — проверка туннеля каждые 15 секунд,
# при обрыве мгновенное переключение на другой сервер из скачанного списка.
PIDFILE=/opt/var/run/xrayguard.pid

case "$1" in
  start)
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
      echo "уже запущен"; exit 0
    fi
    # супервизор: держит сторожа живым. Упал — через 10 секунд поднимется снова.
    (
      trap '' HUP
      while true; do
        /opt/etc/xray/keeper.sh </dev/null >/dev/null 2>&1
        sleep 10
      done
    ) </dev/null >/dev/null 2>&1 &
    echo $! > "$PIDFILE"
    echo "супервизор запущен, pid $(cat $PIDFILE)"
    ;;
  stop)
    [ -f "$PIDFILE" ] && kill "$(cat "$PIDFILE")" 2>/dev/null
    rm -f "$PIDFILE"
    echo "остановлен"
    ;;
  restart)
    $0 stop; sleep 1; $0 start
    ;;
  status)
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
      echo "работает, pid $(cat $PIDFILE)"
    else
      echo "не запущен"
    fi
    ;;
  *)
    echo "usage: $0 {start|stop|restart|status}"
    ;;
esac
