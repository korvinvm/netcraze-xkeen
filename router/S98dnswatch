#!/bin/sh
# Автозапуск DNS-сторожа (см. /opt/etc/xray/dns-watch.sh).
# Имя S98 — стартует раньше S99xrayguard, чтобы сторож был поднят сразу после Xray.

PIDFILE=/opt/var/run/dnswatch-supervisor.pid

case "$1" in
  start)
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
      echo "уже запущен"
      exit 0
    fi
    (
      trap '' HUP
      while true; do
        /opt/etc/xray/dns-watch.sh </dev/null >/dev/null 2>&1
        sleep 10
      done
    ) </dev/null >/dev/null 2>&1 &
    echo $! > "$PIDFILE"
    echo "супервизор запущен, pid $(cat "$PIDFILE")"
    ;;
  stop)
    [ -f "$PIDFILE" ] && kill "$(cat "$PIDFILE")" 2>/dev/null
    rm -f "$PIDFILE"
    for p in $(ps | awk '/xray\/dns-watch\.sh/ && !/awk/ {print $1}'); do
      kill "$p" 2>/dev/null
    done
    echo "остановлен"
    ;;
  restart)
    $0 stop
    sleep 1
    $0 start
    ;;
  status)
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
      echo "работает, pid $(cat "$PIDFILE")"
    else
      echo "не запущен"
    fi
    ;;
  *)
    echo "usage: $0 {start|stop|restart|status}"
    ;;
esac
